# Build context: repo root. docker build -f infra/Dockerfile.broker -t pa-sandbox-broker:dev .

# Node 22.23.2 pushed to Docker Hub 2026-09-19 (newest 22.x tag at least 7 days old on 2026-10-25).
# Digest of the multi-arch index, read with `docker buildx imagetools inspect` on 2026-10-31.
FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# corepack 0.36.0 published 2026-08-28; npm has no release-age gate, so the version is pinned.
RUN npm install -g corepack@0.36.0 && corepack enable && corepack prepare pnpm@12.15.0 --activate
WORKDIR /app

FROM base AS prod
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY services/sandbox-broker services/sandbox-broker
RUN pnpm install --frozen-lockfile --prod --filter @pa/sandbox-broker...

FROM base AS runtime
COPY --from=prod /app/node_modules /app/node_modules
COPY --from=prod /app/services/sandbox-broker /app/services/sandbox-broker
COPY skills /app/skills
ENV NODE_ENV=production DATA_DIR=/data SKILLS_DIR=/app/skills PORT=8100
# Root on purpose: the host Docker socket is root-owned. Compose drops all capabilities but CHOWN
# and DAC_OVERRIDE (needed to create /data/work/<userId> for uid 10001).
EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8100/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "services/sandbox-broker/src/main.ts"]
