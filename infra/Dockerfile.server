# Build context: repo root. docker build -f infra/Dockerfile.server -t pa-server:dev .

# Node 22.23.2 pushed to Docker Hub 2026-09-19 (newest 22.x tag at least 7 days old on 2026-10-25).
# Digest of the multi-arch index, read with `docker buildx imagetools inspect` on 2026-10-31.
FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# corepack 0.36.0 published 2026-08-28; npm has no release-age gate, so the version is pinned.
RUN npm install -g corepack@0.36.0 && corepack enable && corepack prepare pnpm@12.15.0 --activate
WORKDIR /app

FROM base AS manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/server/package.json apps/server/
COPY packages/db/package.json packages/db/
COPY packages/protocol/package.json packages/protocol/
COPY packages/pi-ext-pseudo/package.json packages/pi-ext-pseudo/
COPY packages/pi-ext-topics/package.json packages/pi-ext-topics/
COPY packages/pi-ext-memory/package.json packages/pi-ext-memory/
COPY packages/pi-ext-sandbox/package.json packages/pi-ext-sandbox/
COPY packages/pi-ext-subagents/package.json packages/pi-ext-subagents/
COPY tests/contract/package.json tests/contract/
COPY tests/fake-llm/package.json tests/fake-llm/
COPY apps/web/package.json apps/web/
# Optional workspace (services/sandbox-broker): copied only when present.
RUN --mount=type=bind,source=services,target=/src \
    [ ! -f /src/sandbox-broker/package.json ] || { mkdir -p services/sandbox-broker && cp /src/sandbox-broker/package.json services/sandbox-broker/; }

FROM manifests AS deps
RUN pnpm install --frozen-lockfile

FROM deps AS web
COPY tsconfig.base.json ./
COPY apps/web apps/web
COPY packages/protocol packages/protocol
RUN pnpm --filter @pa/web build

FROM deps AS models
# Build-time network only: the runtime loads the embedding model from /app/models offline.
COPY apps/server/src/embeddings.ts apps/server/src/embeddings.ts
COPY scripts/download-models.mjs scripts/download-models.mjs
RUN node scripts/download-models.mjs /app/models

# From manifests, not deps: a --prod install on top of a full install keeps the dev packages.
FROM manifests AS prod
COPY apps/server apps/server
COPY packages/protocol packages/protocol
COPY packages/db packages/db
COPY packages/pi-ext-pseudo packages/pi-ext-pseudo
COPY packages/pi-ext-topics packages/pi-ext-topics
COPY packages/pi-ext-memory packages/pi-ext-memory
COPY packages/pi-ext-sandbox packages/pi-ext-sandbox
COPY packages/pi-ext-subagents packages/pi-ext-subagents
# The shared private-address rule of `fetch_url` (phase-25 decision 23); the rest of the broker stays out.
COPY services/sandbox-broker/src/net.ts services/sandbox-broker/src/net.ts
# Not `pnpm deploy`: it copies workspace packages into node_modules, where Node refuses to strip types.
RUN pnpm install --frozen-lockfile --prod --filter @pa/server...
# Prune what the server never loads. onnxruntime-node ships binaries for every OS/arch (~230 MB unused);
# onnxruntime-web is the browser/wasm backend, never selected by transformers in Node.
# better-sqlite3 prebuilds: only the glibc build for this arch loads (musl/darwin/win32/other arch are dead);
# deps/ and src/ are the C sources used by node-gyp, which never runs here.
RUN set -e; cd node_modules/.pnpm; \
    ort=$(echo onnxruntime-node@*/node_modules/onnxruntime-node/bin/napi-v6); \
    other=$([ "$(uname -m)" = aarch64 ] && echo x64 || echo arm64); \
    rm -rf "$ort/darwin" "$ort/win32" "$ort/linux/$other"; \
    rm -rf onnxruntime-web@*; \
    sqlite=$(echo better-sqlite3@*/node_modules/better-sqlite3); \
    arch=$([ "$(uname -m)" = aarch64 ] && echo arm64 || echo x64); \
    find "$sqlite/prebuilds" -type f ! -name "linux-$arch.node" -delete; \
    rm -rf "$sqlite/deps" "$sqlite/src"

# OS packages of the runtime, shared with server-test. git versions the memory files (phase-8
# decision 1). Tesseract and Poppler read scanned PDFs locally (phase-16 decision 19).
FROM base AS os
RUN apt-get update && apt-get install -y --no-install-recommends git \
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-fin tesseract-ocr-swe poppler-utils \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info

# Built only with --target server-test: the server's dev dependencies on the runtime's OS packages.
# .dockerignore drops *.test.ts, so mount apps/server/src at run time (docs/decisions/phase-16-polish.md, gate 3).
FROM os AS server-test
COPY --from=deps /app /app
COPY tsconfig.base.json ./
COPY packages packages
COPY tests/fake-llm tests/fake-llm
COPY apps/server apps/server
COPY services/sandbox-broker/src/net.ts services/sandbox-broker/src/net.ts
COPY agents agents
COPY automations automations
COPY skills skills
COPY infra/models.json infra/mcp.yaml infra/

FROM os AS runtime
RUN useradd --uid 10001 --user-group --no-create-home app && mkdir /data && chown app:app /data
COPY --from=prod --chown=app:app /app/node_modules /app/node_modules
COPY --from=prod --chown=app:app /app/apps/server /app/apps/server
COPY --from=prod --chown=app:app /app/packages/protocol /app/packages/protocol
COPY --from=prod --chown=app:app /app/packages/db /app/packages/db
COPY --from=prod --chown=app:app /app/packages/pi-ext-pseudo /app/packages/pi-ext-pseudo
COPY --from=prod --chown=app:app /app/packages/pi-ext-topics /app/packages/pi-ext-topics
COPY --from=prod --chown=app:app /app/packages/pi-ext-memory /app/packages/pi-ext-memory
COPY --from=prod --chown=app:app /app/packages/pi-ext-sandbox /app/packages/pi-ext-sandbox
COPY --from=prod --chown=app:app /app/packages/pi-ext-subagents /app/packages/pi-ext-subagents
COPY --from=prod --chown=app:app /app/services/sandbox-broker /app/services/sandbox-broker
COPY --chown=app:app infra/models.json infra/mcp.yaml /app/infra/
COPY --chown=app:app skills /app/skills
COPY --chown=app:app agents /app/agents
COPY --chown=app:app automations /app/automations
COPY --from=web --chown=app:app /app/apps/web/dist /app/apps/web/dist
COPY --from=models /app/models /app/models
ENV NODE_ENV=production WEB_DIST=/app/apps/web/dist DATA_DIR=/data HOST=0.0.0.0 PORT=3000 MODELS_DIR=/app/models
USER app
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/server/src/main.ts"]
