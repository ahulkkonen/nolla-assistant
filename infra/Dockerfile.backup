# Build context: repo root. docker build -f infra/Dockerfile.backup -t pa-backup:dev .
# restic 0.19.1 image built 2026-07-05 (> 7 days old).
FROM restic/restic:0.19.1@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510
# The base image ships /usr/share/zoneinfo (tzdata); fail the build if Europe/Helsinki is missing.
RUN test -f /usr/share/zoneinfo/Europe/Helsinki \
    && adduser -D -u 10001 -H app && mkdir /data && chown app:app /data
COPY infra/backup/entrypoint.sh /entrypoint.sh
COPY infra/backup/backup-now.sh /backup-now.sh
COPY scripts/restore.sh /scripts/restore.sh
ENV TZ=Europe/Helsinki HOME=/tmp RESTIC_CACHE_DIR=/tmp/restic-cache
USER app
ENTRYPOINT ["/entrypoint.sh"]
