{
  "name": "nolla-assistant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.16"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r --if-present --filter '!@nolla/egress-tests' --filter '!@nolla/sandbox-tests' --filter '!@nolla/memory-eval' test",
    "test:contract": "pnpm --filter @nolla/contract-tests test",
    "test:egress": "pnpm --filter @nolla/egress-tests test",
    "test:sandbox": "pnpm --filter @nolla/sandbox-tests test",
    "test:webkit": "pnpm --filter @nolla/e2e exec playwright test --project webkit",
    "build": "pnpm -r --if-present build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "knip": "6.43.0",
    "typescript": "5.9.3"
  }
}
