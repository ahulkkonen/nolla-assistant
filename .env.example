# Copy to .env for local dev. Production secrets live in Coolify, never in the repo.
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=change-me
PSEUDO_URL=http://pseudo-svc:8000
PSEUDO_VAULT_KEY=change-me-32-bytes-base64
OPENROUTER_API_KEY=            # LiteLLM container only
DATA_DIR=/data
AUTH_PASSKEY_RP_ID=localhost
AUTH_ORIGIN=http://localhost:3000
AUTH_PASSWORD_HASH=            # argon2/scrypt hash for the password fallback
VAPID_PUBLIC=
VAPID_PRIVATE=
RESTIC_PASSWORD=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
