# Copy to .env for local dev. Production secrets live in Coolify, never in the repo.
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=change-me
PSEUDO_URL=http://pseudo-svc:8000
PSEUDO_VAULT_KEY=                   # >= 32 chars: openssl rand -base64 48
OPENROUTER_API_KEY=            # LiteLLM container only
DATA_DIR=/data
AUTH_ORIGIN=http://localhost:3000   # also the only allowed WebSocket Origin
AUTH_PASSKEY_RP_ID=localhost        # defaults to the AUTH_ORIGIN hostname
AUTH_PASSWORD_HASH=                 # scripts/hash-password.mjs output; empty disables password login
COOKIE_SECRET=                      # >= 32 random chars, signs the passkey challenge cookie
# Proxy hops in front of pa-server (Coolify: 1). Unset means no proxy is trusted.
# TRUST_PROXY=1
WEB_DIST=apps/web/dist              # omit to disable static serving
USER_ID=aleksi
MODEL=zdr/strong
HOST=127.0.0.1
PORT=3000
VAPID_PUBLIC=
VAPID_PRIVATE=
RESTIC_PASSWORD=
S3_ENDPOINT=                        # e.g. https://<account>.r2.cloudflarestorage.com, no trailing slash
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# BACKUP_RUN_NOW=1                  # also run one restic snapshot when the backup container starts
# Google Workspace MCP (docs/deploy.md "Integrations"). The redirect URI is ${AUTH_ORIGIN}/api/oauth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=          # mcp-workspace container only
GOOGLE_ACCOUNT_EMAIL=                # your Google address; allowlisted in the vault (SELF_EMAIL)
# MCP_CONFIG=infra/mcp.yaml          # `none` disables MCP
# MCP_WORKSPACE_URL=http://mcp-workspace:8000   # OAuth callback target; default: origin of the mcp.yaml URL
